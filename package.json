  "private": false,
  "description": "Open-source AI tutor & cognitive twin for the Polish 8th-grade exam (egzamin ósmoklasisty) and beyond.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://lkolo-prez.github.io/ai-nauczyciel/",
  "repository": {
    "type": "git",
